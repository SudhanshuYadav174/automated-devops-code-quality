{ "name": "node-code-quality-security-demo", "version": "1.3.0", "description": "Node.js demo with comprehensive automated code quality, security, supply chain & compliance pipeline.", "main": "src/index.js", "scripts": { "start": "node src/index.js", "lint": "eslint .", "lint:ci": "eslint -f sarif -o eslint-report.sarif . || true", "test": "jest --runInBand", "test:coverage": "jest --coverage", "sonar": "sonar-scanner", "prepare": "husky install", "audit": "npm audit --audit-level=high", "sbom": "cyclonedx-npm --output-format json --output-file sbom.json", "scan:snyk": "snyk test --severity-threshold=high || true", "scan:snyk:monitor": "snyk monitor --severity-threshold=high || true", "licenses:json": "license-checker --production --json --out license-report.json", "licenses:csv": "license-checker --production --csv --out license-report.csv", "gitleaks:scan": "gitleaks detect --no-banner --redact --config=gitleaks.toml --report-format sarif --report-path gitleaks-precommit.sarif || true", "coverage:check": "jest --coverage", "detect:fail-high-vulns": "node scripts/fail-on-threshold.js" }, "keywords": [ "devops", "sonarqube", "codeql", "eslint", "ci", "security", "quality", "semgrep", "gitleaks", "trivy", "sbom", "snyk", "dependency-check", "tfsec", "checkov", "cosign" ], "author": "Your Name", "license": "MIT", "devDependencies": { "@cyclonedx/cyclonedx-npm": "^1.15.0", "eslint": "^9.11.0", "eslint-formatter-sarif": "^3.1.0", "husky": "^9.0.0", "jest": "^29.7.0", "license-checker": "^25.0.1", "lint-staged": "^15.2.0" }, "lint-staged": { "*.js": [ "eslint --fix", "git add" ] } }